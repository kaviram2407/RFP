# Environment Variables Example

# App Settings
APP_NAME="AI-RFP Platform"
APP_ENV=development
DEBUG=True

# Postgres Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rfp_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# JWT Authentication
JWT_SECRET_KEY=changeme-in-production-very-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Provider Configuration (local vs r2)
# Use 'local' for zero-cloud local development or 'r2' for Cloudflare R2 production deployment
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=storage

# File Upload & Cloudflare R2
MAX_UPLOAD_SIZE_BYTES=52428800
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=rfp-documents
R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_REGION=auto


# NVIDIA LLM & Requirement Extraction
NVIDIA_API_KEY=your_nvidia_nim_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
LLM_REQUEST_TIMEOUT_SECONDS=120
REQUIREMENT_EXTRACTION_CONFIDENCE_THRESHOLD=0.7
REQUIREMENT_EXTRACTION_CONTEXT_SIZE=8000

# NVIDIA Embeddings & RAG Retrieval
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBEDDING_DIMENSIONS=2048
HYBRID_SEARCH_SEMANTIC_WEIGHT=0.70
HYBRID_SEARCH_LEXICAL_WEIGHT=0.30




